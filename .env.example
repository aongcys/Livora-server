# Copy to .env and fill in real values. Never commit .env.
# Every variable below is required; the app will not start if one is missing.

NODE_ENV=development
PORT=4200
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3200

# Supabase: Project -> Connect. Use the TRANSACTION pooler (port 6543) here.
# Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Supabase: use the SESSION pooler (port 5432) here.
# Used only by the Prisma CLI (migrate/studio), not by the running app.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
